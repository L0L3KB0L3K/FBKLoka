---
// /treningi: training times of all teams (SPEC.md §7.4). One card per team with a small table:
// no sideways scrolling on a phone. Teams without slots and without a training note are not shown.
// A team that trains with another one (treniraZ, e.g. U19 with Člani) has no card of its own: the host card
// is titled "Člani in U19" and shows the guest's note (owner, 28. 9. 2026).
import { loadCollection } from "../lib/content.ts";
import TrainingTable from "../components/TrainingTable.astro";
import Base from "../layouts/Base.astro";
import { isSet } from "../lib/site.ts";
import { getTrainings } from "../lib/trainings.ts";

const teams = (await loadCollection("selekcije")).sort((a, b) => a.data.vrstniRed - b.data.vrstniRed);
const coaches = new Map((await loadCollection("trenerji")).map((coach) => [coach.id, coach.data.ime]));
const trainings = await getTrainings();

const cards = teams
  .filter((team) => !team.data.treniraZ)
  .map((team) => {
    const guests = teams.filter((other) => other.data.treniraZ === team.id);
    return {
      team,
      guests,
      notes: [team, ...guests].map((t) => t.data.treningiOpomba).filter((note): note is string => isSet(note)),
      trainings: trainings.filter((t) => t.selekcija === team.id),
      coaches: team.data.trenerji.map((id) => coaches.get(id)).filter((name): name is string => Boolean(name)),
    };
  })
  .filter((card) => card.trainings.length > 0 || card.notes.length > 0);
---

<Base title="Treningi" description="Urnik treningov floorballa v Škofji Loki za vse selekcije FBK Loka, od U9 do članov.">
  <div class="page-wrap py-12">
    <h1>Treningi</h1>

    {
      cards.length > 0 && (
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {cards.map(({ team, guests, notes, trainings, coaches }) => (
            <section aria-labelledby={`treningi-${team.id}`} class="rounded-card border border-line bg-paper p-6">
              <h2 id={`treningi-${team.id}`} class="text-h3">
                <a href={`/ekipe/${team.id}/`}>{team.data.ime}</a>
                {guests.map((guest) => (
                  <Fragment>
                    {" in "}
                    <a href={`/ekipe/${guest.id}/`}>{guest.data.ime}</a>
                  </Fragment>
                ))}
              </h2>
              {coaches.length > 0 && (
                <p class="mt-1 text-small text-muted">
                  {coaches.length > 1 ? "Trenerji" : "Trener"}: {coaches.join(", ")}
                </p>
              )}
              {notes.map((note) => (
                <p class="mt-4">{note}</p>
              ))}
              {trainings.length > 0 && (
                <div class="mt-4">
                  <TrainingTable trainings={trainings} caption={`Treningi ${team.data.ime}`} />
                </div>
              )}
            </section>
          ))}
        </div>
      )
    }
  </div>
</Base>
