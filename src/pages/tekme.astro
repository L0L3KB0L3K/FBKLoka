---
// /tekme: all matches of all teams (SPEC.md §7.3).
// Upcoming on top, played below (newest first), grouped by week. One filter: team (?s=u15).
// Without JS every match is shown; the filter script only hides rows of other teams (TeamFilter).
import { getCollection } from "astro:content";
import MatchList from "../components/MatchList.astro";
import TeamFilter from "../components/TeamFilter.astro";
import Base from "../layouts/Base.astro";
import { allMatches } from "../lib/match-data.ts";
import { sportsEvents } from "../lib/jsonld.ts";
import { splitByState, uniqueGames } from "../lib/matches.ts";

const teams = (await getCollection("selekcije")).sort((a, b) => a.data.vrstniRed - b.data.vrstniRed);
const teamNames = Object.fromEntries(teams.map((team) => [team.id, team.data.ime]));
const games = uniqueGames(allMatches);
const { prihodnje, odigrane } = splitByState(games);
const jsonLd = sportsEvents(prihodnje);

// The filter lists only teams with matches.
const filterTeams = teams
  .filter((team) => games.some((game) => game.selekcija === team.id))
  .map((team) => ({ id: team.id, ime: team.data.ime }));
---

<Base title="Tekme" jsonLd={jsonLd} description="Razpored in rezultati tekem vseh selekcij FBK Loka, od članov v IFL do mladih.">
  <div class="page-wrap py-12">
    <h1>Tekme</h1>

    <TeamFilter teams={filterTeams} path="/tekme/" groups="[data-week], [data-match-section]" />

    {
      prihodnje.length > 0 && (
        <section aria-labelledby="prihodnje" class="mt-10" data-match-section>
          <h2 id="prihodnje">Prihodnje tekme</h2>
          <MatchList matches={prihodnje} teamNames={teamNames} />
        </section>
      )
    }

    {
      odigrane.length > 0 && (
        <section aria-labelledby="odigrane" class="mt-14" data-match-section>
          <h2 id="odigrane">Odigrane tekme</h2>
          <MatchList matches={odigrane} teamNames={teamNames} />
        </section>
      )
    }
  </div>
</Base>
