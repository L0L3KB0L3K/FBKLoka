---
// /novice/[slug] (SPEC.md §7.8): title, date, team, cover, text and a link back to all news.
// The URL is the file name, e.g. /novice/2026-04-12-u17-drzavni-prvaki/ (Decap's default slug also starts with the date).
// The cover is shown whole (no crop, height capped) and is the share image as a 1200×630 crop.
// An Instagram post (SPEC.md §6) adds more photos under the text and a link to the post; a video links right under
// its thumbnail, so nobody waits for a photo to play.
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArrowLink from "../../components/ArrowLink.astro";
import Gallery from "../../components/Gallery.astro";
import NewTabIcon from "../../components/NewTabIcon.astro";
import Base from "../../layouts/Base.astro";
import { shareImage } from "../../lib/share.ts";
import { loadCollection } from "../../lib/content.ts";
import { formatDate } from "../../lib/format.ts";
import { newsArticle } from "../../lib/jsonld.ts";
import { published } from "../../lib/news.ts";

export async function getStaticPaths() {
  const posts = published(await getCollection("novice")); // a draft gets no page
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"novice">;
}

const { post } = Astro.props;
const { naslov, datum, povzetek, naslovnaSlika, slikaAlt, selekcija, galerija, instagram, video } = post.data;
const { Content } = await render(post);
const team = selekcija ? (await loadCollection("selekcije")).find((entry) => entry.id === selekcija) : undefined;
const iso = datum.toISOString();

// Share image for Facebook, WhatsApp and search: the cover as a 1.91:1 crop (src/lib/share.ts).
const ogImage = await shareImage(naslovnaSlika, slikaAlt, Astro.site as URL);
const jsonLd = newsArticle(Astro.site as URL, new URL(Astro.url.pathname, Astro.site), naslov, datum, ogImage.url);
---

<Base title={naslov} description={povzetek} ogImage={ogImage} jsonLd={jsonLd}>
  <article class="page-wrap py-12">
    <h1 class="max-w-[30ch]">{naslov}</h1>
    <p class="mt-6 text-small text-muted">
      <time datetime={iso.slice(0, 10)}>{formatDate(iso)}</time>
      {team && <span> · <a href={`/ekipe/${team.id}/`}>{team.data.ime}</a></span>}
    </p>

    {/* Top of the page, so it loads first (priority), never lazy. */}
    <Image
      src={naslovnaSlika}
      alt={slikaAlt}
      widths={[640, 960, 1280]}
      sizes="(min-width: 48rem) 42rem, 100vw"
      priority
      class="mt-8 block h-auto max-h-[36rem] w-auto max-w-full rounded-card border border-line"
    />

    {
      instagram && video && (
        <p class="mt-4">
          <a href={instagram} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1 font-semibold">
            Poglejte video na Instagramu
            <NewTabIcon class="inline size-4" />
          </a>
        </p>
      )
    }

    <div class="mt-8 prose">
      <Content />
    </div>

    {/* Same width as the cover; the photos are below the text. */}
    <Gallery photos={galerija} class="mt-8" />

    {
      instagram && !video && (
        <p class="mt-8">
          <a href={instagram} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1 font-semibold">
            Objava na Instagramu
            <NewTabIcon class="inline size-4" />
          </a>
        </p>
      )
    }

    <p class="mt-12">
      <ArrowLink href="/novice/">Vse novice</ArrowLink>
    </p>
  </article>
</Base>
