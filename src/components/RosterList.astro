---
// Team roster (SPEC.md §7.2, §8): active players only, goalkeepers, defenders, forwards.
// Minors never show their year of birth (SPEC.md §4.5, §12). Nothing is rendered without players.
import type { CollectionEntry } from "astro:content";
import { canShowBirthYear, POSITION_ORDER, POSITION_TITLES } from "../lib/players.ts";

interface Props {
  players: CollectionEntry<"igralci">[];
}

const { players } = Astro.props;
const today = new Date();
const groups = POSITION_ORDER.map((position) => ({
  title: POSITION_TITLES[position],
  players: players
    .filter((p) => p.data.aktiven && p.data.pozicija === position)
    .sort((a, b) => a.data.stevilka - b.data.stevilka || a.data.ime.localeCompare(b.data.ime, "sl")),
})).filter((group) => group.players.length > 0);
---

{
  groups.map((group) => (
    <section class="mt-6 first:mt-0">
      <h3>{group.title}</h3>
      <ul class="mt-2">
        {group.players.map(({ data }) => (
          <li class="flex gap-4 border-b border-line py-3">
            <span class="w-8 shrink-0 text-right font-bold tabular-nums">{data.stevilka > 0 ? data.stevilka : ""}</span>
            <span>
              {data.ime}
              {canShowBirthYear(data.letnik, today) && <span class="text-small text-muted"> letnik {data.letnik}</span>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))
}
