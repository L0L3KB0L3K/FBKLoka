---
// Team roster (SPEC.md §7.2, §8): goalkeepers, defenders, forwards, then players without a position.
// Comes from teamRoster(): FloorballFlash plus src/content/igralci, inactive players already left out.
// Minors never show their year of birth (SPEC.md §4.5, §12). Nothing is rendered without players.
import { canShowBirthYear, POSITION_ORDER, POSITION_TITLES, type RosterEntry } from "../lib/players.ts";

interface Props {
  players: RosterEntry[];
}

const { players } = Astro.props;
const today = new Date();
// Number order; no number goes last, then by name.
const byNumber = (a: RosterEntry, b: RosterEntry) =>
  (a.stevilka ?? 1000) - (b.stevilka ?? 1000) || a.ime.localeCompare(b.ime, "sl");
const groups = [
  ...POSITION_ORDER.map((position) => ({ title: POSITION_TITLES[position], players: players.filter((p) => p.pozicija === position) })),
  { title: "Igralci", players: players.filter((p) => p.pozicija === null) },
]
  .map((group) => ({ ...group, players: [...group.players].sort(byNumber) }))
  .filter((group) => group.players.length > 0);
---

{
  groups.map((group) => (
    <section class="mt-6 first:mt-0">
      <h3>{group.title}</h3>
      <ul class="mt-2">
        {group.players.map((player) => (
          <li class="flex gap-4 border-b border-line py-3">
            <span class="w-8 shrink-0 text-right font-bold tabular-nums">
              {player.stevilka !== null && player.stevilka > 0 ? player.stevilka : ""}
            </span>
            <span>
              {player.ime}
              {canShowBirthYear(player.letnik, today) && <span class="text-small text-muted"> letnik {player.letnik}</span>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))
}
