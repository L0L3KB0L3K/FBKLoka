---
// Team roster (SPEC.md §7.2, §8): goalkeepers, defenders, forwards, then players without a position.
// Comes from teamRoster(): FloorballFlash plus src/content/igralci, inactive players already left out.
// Minors never show their year of birth (SPEC.md §4.5, §12). Nothing is rendered without players.
// A selection with several teams (U17 A and B) shows one roster per team, the team name above its positions
// (Maj, 7. 11. 2026); only when every player has a team, otherwise one list as before.
import { canShowBirthYear, POSITION_ORDER, POSITION_TITLES, type RosterEntry } from "../lib/players.ts";

interface Props {
  players: RosterEntry[];
}

const { players } = Astro.props;
const today = new Date();
// Number order; no number goes last, then by name.
const byNumber = (a: RosterEntry, b: RosterEntry) =>
  (a.stevilka ?? 1000) - (b.stevilka ?? 1000) || a.ime.localeCompare(b.ime, "sl");
const positionGroups = (list: RosterEntry[]) =>
  [
    ...POSITION_ORDER.map((position) => ({ title: POSITION_TITLES[position], players: list.filter((p) => p.pozicija === position) })),
    { title: "Igralci", players: list.filter((p) => p.pozicija === null) },
  ]
    .map((group) => ({ ...group, players: [...group.players].sort(byNumber) }))
    .filter((group) => group.players.length > 0);
const teamNames = [...new Set(players.map((p) => p.ekipa ?? ""))].sort((a, b) => a.localeCompare(b, "sl"));
const byTeam = teamNames.length > 1 && players.every((p) => p.ekipa);
const teams = byTeam
  ? teamNames.map((ekipa) => ({ ekipa, groups: positionGroups(players.filter((p) => p.ekipa === ekipa)) }))
  : [{ ekipa: "", groups: positionGroups(players) }];
const Title = byTeam ? "h4" : "h3";
---

{
  teams.map((team) => (
    <div class:list={[byTeam && "mt-12 first:mt-0"]}>
      {byTeam && <h3 class="text-h2">{team.ekipa}</h3>}
      {team.groups.map((group) => (
        <section class:list={["mt-6", !byTeam && "first:mt-0"]}>
          <Title>{group.title}</Title>
          <ul class="mt-2">
            {group.players.map((player) => (
              <li class="flex gap-4 border-b border-line py-3">
                <span class="w-8 shrink-0 text-right font-bold tabular-nums">
                  {player.stevilka !== null && player.stevilka > 0 ? player.stevilka : ""}
                </span>
                <span>
                  {player.ime}
                  {canShowBirthYear(player.letnik, today) && <span class="text-small text-muted"> letnik {player.letnik}</span>}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  ))
}
