---
// Button or link styled as a button (SPEC.md §9.2, §9.6).
// Two variants only, so no cva (SPEC.md §2):
//   on-ink   = yellow background, black text (on black surfaces)
//   on-paper = black background, white text (on white surfaces)
// Renders <a> when href is given, otherwise <button>.
// size lg: the one main call to action of a page (/vpis, the join band on the home page).
// arrow: an arrow after the label that moves 4 px on hover, for buttons that lead to another page.
// newTab: an outside service (EOS) in a new tab, with the new-tab mark instead of the arrow.
// Shape: a pill, like every control on the site (radius rule in global.css).
import ArrowIcon from "../ArrowIcon.astro";
import NewTabIcon from "../NewTabIcon.astro";

interface Props {
  variant: "on-ink" | "on-paper";
  href?: string;
  type?: "button" | "submit";
  size?: "md" | "lg";
  arrow?: boolean;
  newTab?: boolean;
  class?: string;
}

const { variant, href, type = "button", size = "md", arrow = false, newTab = false, class: className } = Astro.props;

const classes = [
  "btn group inline-flex items-center justify-center gap-2 rounded-full font-bold whitespace-nowrap no-underline disabled:cursor-not-allowed disabled:opacity-70",
  size === "lg" ? "min-h-14 px-8 text-h3" : "min-h-11 px-6",
  variant === "on-ink" ? "bg-ball text-ink hover:bg-paper" : "bg-ink text-paper hover:text-ball",
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} target={newTab ? "_blank" : undefined} rel={newTab ? "noopener" : undefined}>
      <slot />
      {newTab ? <NewTabIcon /> : arrow && <ArrowIcon class="btn-arrow" />}
    </a>
  ) : (
    <button type={type} class:list={classes}>
      <slot />
      {arrow && <ArrowIcon class="btn-arrow" />}
    </button>
  )
}

<style>
  /* Hover: colour, 150 ms. Press: scale 0.97, 120 ms (SPEC.md §9.6). Arrow: 4 px nudge on hover. */
  .btn {
    transition:
      color var(--dur-hover) ease,
      background-color var(--dur-hover) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-arrow {
    transition: transform var(--dur-hover) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .btn:hover .btn-arrow {
      transform: translateX(4px);
    }
  }

  /* Reduced motion: no movement, colour changes stay. */
  @media (prefers-reduced-motion: reduce) {
    .btn:active {
      transform: none;
    }
  }
</style>
