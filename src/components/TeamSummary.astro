---
// Left column of a team page (SPEC.md §7.2, §8): age, coaches, captain, training times,
// titles and "Dodaj v koledar". Each item appears only with real content;
// with no content at all, nothing is rendered (SPEC.md §1).
import type { CollectionEntry } from "astro:content";
import { isSet } from "../lib/site.ts";
import { hasSummary } from "../lib/teams.ts";
import { groupTitles } from "../lib/titles.ts";
import type { Training } from "../lib/trainings.ts";
import CalendarButton from "./CalendarButton.astro";
import TrainingTable from "./TrainingTable.astro";

interface Props {
  team: CollectionEntry<"selekcije">;
  coaches: CollectionEntry<"trenerji">[];
  trainings: Training[];
}

const { team, coaches, trainings } = Astro.props;
const { starostniRazpon, kapetan, naslovi, koledar, treningiOpomba } = team.data;
const hasContent = hasSummary(team, coaches, trainings);
---

{
  hasContent && (
    <aside aria-label={`Povzetek: ${team.data.ime}`} class="bg-court p-5">
      <dl class="space-y-4">
        {isSet(starostniRazpon) && (
          <div>
            <dt class="text-small text-muted">Starost</dt>
            <dd class="font-semibold">{starostniRazpon}</dd>
          </div>
        )}
        {coaches.length > 0 && (
          <div>
            <dt class="text-small text-muted">{coaches.length > 1 ? "Trenerji" : "Trener"}</dt>
            {coaches.map((coach) => (
              <dd class="font-semibold">
                {coach.data.ime} <span class="text-small font-normal text-muted">{coach.data.vloga}</span>
              </dd>
            ))}
          </div>
        )}
        {isSet(kapetan) && (
          <div>
            <dt class="text-small text-muted">Kapetan</dt>
            <dd class="font-semibold">{kapetan}</dd>
          </div>
        )}
        {(trainings.length > 0 || isSet(treningiOpomba)) && (
          <div>
            <dt class="text-small text-muted">Treningi</dt>
            <dd>
              <TrainingTable trainings={trainings} compact />
              {isSet(treningiOpomba) && <p>{treningiOpomba}</p>}
            </dd>
          </div>
        )}
        {naslovi.length > 0 && (
          <div>
            <dt class="text-small text-muted">Naslovi</dt>
            {groupTitles(naslovi).map((group) => (
              <dd>
                <span class="font-semibold">{group.naziv}</span>{" "}
                <span class="tabular-nums">{group.leta.join(", ")}</span>
              </dd>
            ))}
          </div>
        )}
      </dl>
      {isSet(koledar) && (
        <div class="mt-6">
          <CalendarButton url={koledar} />
        </div>
      )}
    </aside>
  )
}
