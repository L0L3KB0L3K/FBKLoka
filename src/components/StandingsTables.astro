---
// League tables on a team page (SPEC.md §5.8, §7.2): one table per competition.
// Every team shows its FloorballFlash logo at the same size, ours too (owner, 28. 9. 2026); our row is bold
// on a light yellow tint with a black bar on the left. Rows turn grey under the mouse to help reading across.
// Tables where nobody has played yet are left out by the page (SPEC.md §1: no empty sections).
// On a phone the overtime columns are hidden, so the table fits 320 px; the box still scrolls sideways
// if a long name needs it, and takes keyboard focus for that (axe: scrollable-region-focusable).
import { formatDate } from "../lib/format.ts";
import type { Standings } from "../lib/types.ts";
import TeamLogo from "./TeamLogo.astro";

interface Props {
  standings: Standings[];
  /** When the data last changed (standings.json). */
  updated: string;
}

const { standings, updated } = Astro.props;
const showTies = standings.some((s) => s.tabele.some((t) => t.vrstice.some((row) => row.remi > 0)));
const cell = "px-2 py-2.5 text-right first:pl-3 last:pr-3";
const overtime = `${cell} hidden sm:table-cell`;
---

{
  standings.map((competition, index) => (
    <section class:list={[index > 0 && "mt-10"]} aria-labelledby={`lestvica-${competition.competitionId}`}>
      <h3 id={`lestvica-${competition.competitionId}`}>{competition.tekmovanje}</h3>
      {competition.tabele.map((table) => (
        <section class="mt-3 overflow-x-auto rounded-card border border-line" tabindex="0" aria-label={`Lestvica ${competition.tekmovanje}`}>
          <table class="w-full text-small tabular-nums">
            <caption class="sr-only">
              Lestvica {competition.tekmovanje}
              {competition.tabele.length > 1 && `, ${table.ime}`}
            </caption>
            <thead class="border-b border-line bg-court">
              <tr>
                <th scope="col" class={cell}>
                  <span aria-hidden="true">#</span>
                  <span class="sr-only">Mesto</span>
                </th>
                <th scope="col" class="px-2 py-2.5 text-left">Ekipa</th>
                <th scope="col" class={cell}>
                  <span aria-hidden="true">T</span>
                  <span class="sr-only">Tekme</span>
                </th>
                <th scope="col" class={cell}>
                  <span aria-hidden="true">Z</span>
                  <span class="sr-only">Zmage</span>
                </th>
                <th scope="col" class={overtime}>
                  <span aria-hidden="true">ZP</span>
                  <span class="sr-only">Zmage po podaljšku</span>
                </th>
                {showTies && (
                  <th scope="col" class={cell}>
                    <span aria-hidden="true">R</span>
                    <span class="sr-only">Remiji</span>
                  </th>
                )}
                <th scope="col" class={overtime}>
                  <span aria-hidden="true">PP</span>
                  <span class="sr-only">Porazi po podaljšku</span>
                </th>
                <th scope="col" class={cell}>
                  <span aria-hidden="true">P</span>
                  <span class="sr-only">Porazi</span>
                </th>
                <th scope="col" class={cell}>Goli</th>
                <th scope="col" class={cell}>
                  <span aria-hidden="true">Tč</span>
                  <span class="sr-only">Točke</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {table.vrstice.map((row) => (
                <tr class:list={["standings-row border-b border-line last:border-b-0", row.loka && "standings-ours font-bold"]}>
                  <td class={cell}>{row.mesto}.</td>
                  <th scope="row" class="px-2 py-2.5 text-left [font-weight:inherit]">
                    <span class="flex items-center gap-2">
                      <TeamLogo file={row.logo} />
                      {row.ekipa}
                    </span>
                  </th>
                  <td class={cell}>{row.tekme}</td>
                  <td class={cell}>{row.zmage}</td>
                  <td class={overtime}>{row.zmagePodaljsek}</td>
                  {showTies && <td class={cell}>{row.remi}</td>}
                  <td class={overtime}>{row.poraziPodaljsek}</td>
                  <td class={cell}>{row.porazi}</td>
                  <td class={cell}>
                    {row.goliDani}:{row.goliPrejeti}
                  </td>
                  <td class={`${cell} font-bold`}>{row.tocke}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}
    </section>
  ))
}

<p class="mt-4 text-small text-muted">
  T tekme, Z zmage, P porazi{showTies && ", R remiji"}, Tč točke. Na širšem zaslonu še ZP in PP: zmage in porazi po
  podaljšku ali kazenskih strelih.
</p>
<p class="mt-2 text-small text-muted">
  Vir: FloorballFlash, stanje {formatDate(updated)}.
  {
    standings.map((competition) => (
      <>
        {" "}
        <a href={`https://www.floorballflash.at/competition/${competition.competitionId}/standings`}>
          Lestvica {competition.tekmovanje} na FloorballFlash
        </a>
        .
      </>
    ))
  }
</p>

<style>
  .standings-row {
    transition: background-color var(--dur-hover) ease;
  }

  /* Our row: light yellow tint (text stays black) and a black bar on the left edge. */
  .standings-ours {
    background-color: color-mix(in srgb, var(--color-ball) 28%, var(--color-paper));
    box-shadow: inset 4px 0 0 var(--color-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .standings-row:not(.standings-ours):hover {
      background-color: var(--color-court);
    }
  }
</style>
