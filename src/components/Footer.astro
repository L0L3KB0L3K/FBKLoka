---
// Site footer (SPEC.md §8, §9.5): black, three columns (contact, links, social)
// and a membership line with a link to the federation. Contact is one click away from every page.
// The sponsor strip joins in step 2, together with the `sponzorji` collection.
import { MAIN_NAV } from "../config/nav";
import { getSettings, isSet } from "../lib/site";

const { email, telefon, naslov, eos, socialna } = await getSettings();

// Same links as the main menu (also the no-JS fallback for the mobile menu), plus privacy.
// /kodeks is added in phase 2, when the page exists.
const links = [
  ...MAIN_NAV.filter((link) => link.href !== "/"),
  { href: "/zasebnost", label: "Zasebnost" },
];
const eosUrl = isSet(eos.portal) ? eos.portal : null;

const social = [
  { href: socialna.instagram, label: "Instagram" },
  { href: socialna.facebook, label: "Facebook" },
].filter((item): item is { href: string; label: string } => isSet(item.href));

const year = new Date().getFullYear();
---

<footer class="surface-ink mt-16">
  <div class="page-wrap grid gap-10 py-12 md:grid-cols-3">
    <section aria-labelledby="footer-contact">
      <h2 id="footer-contact" class="text-h3">Kontakt</h2>
      <ul class="mt-2">
        {isSet(email) && <li><a href={`mailto:${email}`} class="inline-flex min-h-11 min-w-11 items-center hover:text-ball">{email}</a></li>}
        {
          isSet(telefon) && (
            <li>
              <a href={`tel:${telefon.replace(/\s/g, "")}`} class="inline-flex min-h-11 min-w-11 items-center hover:text-ball">
                {telefon}
              </a>
            </li>
          )
        }
        {isSet(naslov) && <li>{naslov}</li>}
        <li><a href="/kontakt" class="inline-flex min-h-11 min-w-11 items-center hover:text-ball">Vsi kontakti</a></li>
      </ul>
    </section>

    <nav aria-labelledby="footer-links">
      <h2 id="footer-links" class="text-h3">Povezave</h2>
      <ul class="mt-2">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} class="inline-flex min-h-11 min-w-11 items-center hover:text-ball">
                {label}
              </a>
            </li>
          ))
        }
        {
          eosUrl && (
            <li>
              <a href={eosUrl} class="inline-flex min-h-11 min-w-11 items-center hover:text-ball">
                Za starše in člane (EOS)
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    {
      social.length > 0 && (
        <section aria-labelledby="footer-social">
          <h2 id="footer-social" class="text-h3">
            Spremljaj nas
          </h2>
          <ul class="mt-2">
            {social.map(({ href, label }) => (
              <li>
                <a href={href} class="inline-flex min-h-11 min-w-11 items-center hover:text-ball">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <div class="page-wrap">
    <div class="flex flex-col gap-2 border-t border-muted py-6 text-small md:flex-row md:justify-between">
      <p>Član <a href="https://floorballslo.si/" class="inline-flex min-h-11 min-w-11 items-center hover:text-ball">Floorball zveze Slovenije</a></p>
      <p>© {year} FBK Loka</p>
    </div>
  </div>
</footer>
