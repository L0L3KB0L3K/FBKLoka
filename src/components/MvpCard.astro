---
// "Igralec tedna" on the home page (MVP vikenda in the code; SPEC.md §20.3, club decisions 29. 9. and 26. 10. 2026):
// heading with a crown, the player's photo,
// the name, the team and the weekend, one line per match ("Tekma proti FBC Borovnica: 2 gola, 1 podaja") and the
// season total (IFL for a senior, the team's own competition otherwise). Any team's player can be MVP.
// Data: src/data/ff/mvp.json and the photo in src/data/ff/mvp/ (scripts/fetch-mvp.ts). Nothing is rendered without
// data (SPEC.md §1). Only the name, the photo and match numbers: never a birth year, school or contact.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import data from "../data/ff/mvp.json";
import { loadCollection } from "../lib/content.ts";
import { statsText, weekendText, type Mvp } from "../lib/mvp.ts";

const mvp = data as unknown as Mvp | null;
const photos = import.meta.glob<{ default: ImageMetadata }>("/src/data/ff/mvp/*.{jpeg,jpg,png,webp}", { eager: true });
const photo = mvp?.slika ? photos[`/src/data/ff/mvp/${mvp.slika}`]?.default : undefined;
// Team names, e.g. "U13". A file from before 26. 10. 2026 has no ekipe: then no team is named.
const teams = await loadCollection("selekcije");
const ekipe = (mvp?.ekipe ?? []).map((id) => teams.find((team) => team.id === id)?.data.ime ?? id);
---

{
  mvp && (
    <section aria-labelledby="igralec-tedna" class="page-wrap py-12">
      <h2 id="igralec-tedna" class="heading-bar">
        Igralec tedna
        {/* Crown: yellow with a black outline like the ball in the logo, so it also reads on white. Decorative,
            hidden from screen readers. Geometry of "crown" from Tabler Icons (MIT, tabler.io/icons), like ArrowIcon. */}
        <svg
          aria-hidden="true"
          class="ml-1 inline-block size-[1.3em] align-[-0.3em] fill-ball"
          viewBox="0 0 24 24"
          width="32"
          height="32"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 6l4 6l5 -4l-2 10h-14l-2 -10l5 4z"></path>
        </svg>
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-[14rem_1fr] sm:items-start">
        {photo && (
          <Image
            src={photo}
            alt={mvp.ime}
            widths={[224, 448]}
            sizes="14rem"
            class="aspect-[3/4] w-56 rounded-card object-cover"
          />
        )}
        <div>
          <p class="text-h2 font-bold">{mvp.ime}</p>
          <p class="mt-1 text-small text-muted">
            {ekipe.length > 0 && `${ekipe.join(", ")} · `}Vikend {weekendText(mvp.vikend)}
          </p>
          {mvp.tekme.map((tekma) => (
            <p class="mt-4">
              Tekma proti {tekma.nasprotnik}: <strong>{statsText(tekma, mvp.vratar)}</strong>
            </p>
          ))}
          {mvp.sezona && (
            <p class="mt-4 border-t border-line pt-4">
              Skupaj v sezoni {mvp.sezonaTekmovanje}: <strong>{statsText(mvp.sezona, mvp.vratar)}</strong>
            </p>
          )}
        </div>
      </div>
    </section>
  )
}
