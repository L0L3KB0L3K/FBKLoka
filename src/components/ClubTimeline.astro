---
// Club timeline, oldest first: beside the text on /klub (SPEC.md §7.6) and on its own page /zgodovina (§7.8).
// A founding or a name change is a bigger marker with the club name, so the titles below it read as that club's.
// Titles show the season, plain events the year. Nothing is rendered without entries (SPEC.md §1).
// No controls in the list; a link may follow it (slot), e.g. "Vsa zgodovina" on /klub.
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  /** Already filtered and sorted by clubTimeline() or historyTimeline() (src/lib/timeline.ts). */
  entries: CollectionEntry<"zgodovina">["data"][];
  /** Show the photos of titles and events (/zgodovina). The narrow /klub column has no room for them. */
  photos?: boolean;
  class?: string;
}

const { entries, photos = false, class: className } = Astro.props;
---

{
  entries.length > 0 && (
    <section aria-labelledby="casovnica" class={className}>
      <h2 id="casovnica" class="heading-bar">
        Časovnica
      </h2>
      <ol class="timeline mt-8">
        {entries.map((entry) =>
          entry.vrsta === "naslovi" || entry.vrsta === "dogodek" ? (
            <li class="timeline-item">
              <p class="font-semibold tabular-nums">{entry.vrsta === "naslovi" ? entry.sezona : entry.leto}</p>
              <p class="mt-1">{entry.dogodek}</p>
              {photos && entry.foto && (
                <Picture
                  src={entry.foto.src}
                  alt={entry.foto.alt}
                  formats={["avif", "webp"]}
                  widths={[480, 960]}
                  sizes="(min-width: 32rem) 28rem, 100vw"
                  class="mt-3 block h-auto w-full max-w-md rounded-card"
                />
              )}
            </li>
          ) : (
            <li class="timeline-item timeline-club">
              <p class="text-small text-muted">
                <span class="tabular-nums">{entry.leto}</span> · {entry.vrsta === "ime" ? "Novo ime" : "Ustanovitev"}
              </p>
              <p class="text-h3 font-bold">{entry.klub}</p>
              <p class="mt-1 text-small">{entry.dogodek}</p>
            </li>
          ),
        )}
      </ol>
      <slot />
    </section>
  )
}

<style>
  /* One vertical line with a dot per entry. The line and dots are decoration: the text carries the meaning. */
  .timeline {
    margin-left: 0.5rem;
    border-left: 2px solid var(--color-line);
  }

  .timeline-item {
    position: relative;
    padding-left: 1.5rem;
    padding-bottom: 1.25rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  /* Small ink dot centred on the line, level with the first text line. */
  .timeline-item::before {
    content: "";
    position: absolute;
    top: 0.55em;
    left: calc(-0.3125rem - 1px);
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 9999px;
    background-color: var(--color-ink);
  }

  /* Founding or new name: bigger yellow dot with an ink ring (yellow as a shape only, never as text). */
  .timeline-club::before {
    top: 0.2rem;
    left: calc(-0.625rem - 1px);
    width: 1.25rem;
    height: 1.25rem;
    border: 3px solid var(--color-ink);
    background-color: var(--color-ball);
  }
</style>
