---
// Large 3:2 photo from src/assets/foto/ (SPEC.md §9.1a): AVIF and WebP in several widths, JPG as fallback.
// At most 56rem wide, so a 2000 px photo is never stretched and does not take the whole screen on desktop.
// Quality "high": with Astro's default the large photos looked soft on big screens (30. 10. 2026).
// priority: for a photo near the top of the page. It is then the largest element and must not be lazy.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  priority?: boolean;
  class?: string;
}

const { src, alt, priority = false, class: className } = Astro.props;
---

<div class={className}>
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    widths={[640, 960, 1280, 1792]}
    sizes="(min-width: 60rem) 56rem, 100vw"
    priority={priority}
    quality="high"
    class="block aspect-[3/2] w-full max-w-4xl rounded-card object-cover"
  />
</div>
