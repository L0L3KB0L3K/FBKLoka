---
// Sponsor logos under the black footer on every page, on a white background (SPEC.md §7.1, §9.5).
// Order: by level when the club sets one (it has none now), then by vrstniRed, then by name.
// No sponsors -> nothing is rendered (SPEC.md §1).
//
// The logos stand still in a wrapped row (audit 30. 10. 2026, SPEC.md §9.6): from 28. 9. they scrolled in a loop with
// a stop button; a still row is easier to read, needs no button and no script, and every logo is always in view.
import { Image } from "astro:assets";
import { loadSponsors } from "../lib/sponsors.ts";

const sponzorji = await loadSponsors();
// Every logo gets the same box and keeps its shape inside it (object-contain), so wide and square logos
// look equally strong. Logo files are trimmed to their content.
const logoClass = "h-12 w-28 object-contain sm:h-16 sm:w-32";
---

{
  sponzorji.length > 0 && (
    <section aria-labelledby="sponsors-title" class="border-t border-line bg-paper text-ink" data-sponsors>
      <div class="page-wrap py-10">
        <div class="flex flex-wrap items-center gap-x-4">
          <h2 id="sponsors-title" class="text-small">
            Sponzorji
          </h2>
          <a href="/podpri-nas/" class="inline-flex min-h-11 items-center text-small font-semibold underline">Postanite sponzor</a>
        </div>
        <ul class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-4">
          {sponzorji.map(({ data }) => (
            <li class="shrink-0">
              {data.povezava ? (
                <a href={data.povezava} class="flex min-h-11 items-center">
                  <Image src={data.logo} alt={data.ime} class={logoClass} />
                </a>
              ) : (
                <Image src={data.logo} alt={data.ime} class={logoClass} />
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
