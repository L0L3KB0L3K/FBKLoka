---
// One labelled form field (SPEC.md §7.5, §7.7, §10). The label is always visible, never a placeholder;
// a placeholder may only show an example ("npr. ime@domena.si").
// `error` says what to fix ("Vpiši e-mail v obliki ime@domena.si."). The form script shows it under
// the field in the error colour; without JS the browser's own check runs (required, type, pattern).
// Look: 48 px high, radius --radius-field, white on the grey form panel; the border turns black under the
// mouse and on focus (the global focus ring stays), red when the value is wrong.
interface Props {
  id: string;
  name: string;
  label: string;
  /** Message shown when the value is missing or wrong. */
  error: string;
  type?: "text" | "email" | "tel";
  as?: "input" | "textarea";
  required?: boolean;
  autocomplete?: string;
  inputmode?: "text" | "numeric" | "email" | "tel";
  pattern?: string;
  maxlength?: number;
  hint?: string;
  /** Example value only, e.g. "npr. ime@domena.si". Never the label. */
  placeholder?: string;
}

const {
  id,
  name,
  label,
  error,
  type = "text",
  as = "input",
  required = false,
  autocomplete,
  inputmode,
  pattern,
  maxlength,
  hint,
  placeholder,
} = Astro.props;

const describedBy = [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(" ");
const control =
  "field-control mt-2 block min-h-12 w-full rounded-field border border-input-border bg-paper px-4 py-3 placeholder:text-muted aria-invalid:border-2 aria-invalid:border-error";
// E-mail addresses are not words: no spell-check underline.
const spellcheck = type === "email" ? "false" : undefined;
---

<div>
  <label for={id} class="block font-semibold">
    {label}
    {!required && <span class="font-normal text-muted"> (neobvezno)</span>}
  </label>
  {hint && <p id={`${id}-hint`} class="text-small text-muted">{hint}</p>}
  {
    as === "textarea" ? (
      <textarea
        id={id}
        name={name}
        rows="5"
        required={required}
        maxlength={maxlength}
        placeholder={placeholder}
        aria-describedby={describedBy}
        data-field
        data-error={error}
        class:list={[control, "resize-y"]}
      />
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        required={required}
        autocomplete={autocomplete}
        inputmode={inputmode}
        pattern={pattern}
        maxlength={maxlength}
        placeholder={placeholder}
        spellcheck={spellcheck}
        aria-describedby={describedBy}
        data-field
        data-error={error}
        class={control}
      />
    )
  }
  <p id={`${id}-error`} class="mt-2 flex items-start gap-2 font-semibold text-error" hidden></p>
</div>

<style>
  .field-control {
    transition: border-color var(--dur-hover) ease;
  }

  .field-control:focus-visible {
    border-color: var(--color-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .field-control:hover:not([aria-invalid="true"]) {
      border-color: var(--color-ink);
    }
  }
</style>
