---
// Match board: the one loud element of the site (SPEC.md §7.1, §9.1, §9.4).
// Black, ball-hole pattern, the next match of any team: team, opponent, date, time, venue, countdown.
// The HTML holds up to 5 upcoming matches and the last result. The script picks what to show in the
// browser (src/lib/upcoming.ts): matches that started more than 3 hours ago are skipped, on match day
// "Danes igramo" appears, and the countdown is refreshed every minute.
// Without JS the first match is shown with its date and no countdown. No matches at all: nothing is
// rendered, and the join section below becomes the first thing on the page.
//
// Photos (owner, 28. 9. 2026, as on the old club site): up to 5 photos behind the board, one after another
// with a slow cross-fade every 6 s. A dark gradient keeps the text readable on any photo. WCAG 2.2.2:
// a button stops the change; with "reduce motion" or without JS the first photo simply stays.
// The photos are decorative (alt=""): the board's information is all in the text.
// Photos 2+ are eager, not lazy (Astro default): hidden under the first one, a lazy image may never load. Low priority.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { formatDateLong, formatTime } from "../lib/format.ts";
import { scoreForLoka } from "../lib/matches.ts";
import type { Match } from "../lib/types.ts";
import Button from "./ui/Button.astro";

interface Props {
  upcoming: Match[];
  last: Match | null;
  teamNames: Record<string, string>;
  /** Photos behind the board, in display order. */
  photos?: ImageMetadata[];
}

const { upcoming, last, teamNames, photos = [] } = Astro.props;

const sides = (match: Match) => {
  const ours = match.ekipaLoka;
  const theirs = match.nasprotnik.ime;
  return match.doma ? [ours, theirs] : [theirs, ours];
};
const venueOf = (match: Match) =>
  match.prizorisce
    ? [match.prizorisce.ime, match.prizorisce.ime.includes(match.prizorisce.kraj) ? "" : match.prizorisce.kraj]
        .filter(Boolean)
        .join(", ")
    : "";
---

{
  (upcoming.length > 0 || last) && (
    <section
      aria-label="Naslednja tekma"
      class:list={["board surface-ink relative overflow-hidden", photos.length > 0 && "flex min-h-[26rem] flex-col md:min-h-[32rem]"]}
      data-board
    >
      {photos.length > 0 && (
        <div aria-hidden="true">
          {photos.map((photo, index) => (
            <div class="board-photo" data-photo data-active={index === 0 ? "" : undefined}>
              <Picture
                src={photo}
                alt=""
                formats={["avif", "webp"]}
                widths={[640, 1280, 1920]}
                sizes="100vw"
                priority={index === 0}
                loading={index === 0 ? undefined : "eager"}
                fetchpriority={index === 0 ? undefined : "low"}
                pictureAttributes={{ class: "contents" }}
                class="size-full object-cover"
              />
            </div>
          ))}
          {/* Darkest at the bottom, where the text sits. */}
          <div class="absolute inset-0 bg-linear-to-t from-ink via-ink/75 to-ink/45" />
        </div>
      )}
      <div class:list={["board-pattern", photos.length > 0 && "board-pattern-soft"]} aria-hidden="true" />
      <div class:list={["page-wrap relative py-12 md:py-16", photos.length > 0 && "flex w-full flex-1 flex-col justify-end pt-20 md:pt-24"]}>
        {photos.length > 1 && (
          <button
            type="button"
            class="absolute top-4 right-5 inline-flex min-h-11 items-center text-small font-semibold underline hover:text-ball md:right-8"
            data-photos-toggle
            hidden
          >
            <span data-photos-label>Ustavi</span>
            <span class="sr-only"> menjavo slik</span>
          </button>
        )}
        {upcoming.map((match, index) => {
          const [home, away] = sides(match);
          const venue = venueOf(match);
          return (
            <article class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end" data-slide data-start={match.zacetek} hidden={index > 0}>
              <div>
                <p class="flex flex-wrap items-center gap-3">
                  <span class="rounded-full bg-ball px-3 py-1 font-bold text-ink" data-today hidden>
                    Danes igramo
                  </span>
                  <span>
                    <span class="font-bold">{teamNames[match.selekcija]}</span> {match.tekmovanje}
                  </span>
                </p>
                <p class="mt-4 text-h1 font-extrabold [font-stretch:125%]">
                  {home}
                  <span aria-hidden="true"> – </span>
                  <span class="sr-only"> proti </span>
                  {away}
                </p>
                {venue && <p class="mt-3">{venue}</p>}
              </div>
              <div class="md:text-right">
                <p class="text-h3 font-bold">
                  <time datetime={match.zacetek}>
                    {formatDateLong(match.zacetek).replace(/ \d{4}$/, "")}
                    <span class="block text-h1 tabular-nums">{formatTime(match.zacetek)}</span>
                  </time>
                </p>
                <p class="mt-2 min-h-[1.5em] text-h3 font-bold text-ball" data-countdown />
                <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 md:justify-end">
                  <a href={match.ffUrl} class="inline-flex min-h-11 items-center font-bold hover:text-ball" data-live hidden>
                    V živo na FloorballFlash
                  </a>
                  <Button href="/tekme/" variant="on-ink" arrow>
                    Vse tekme
                  </Button>
                </div>
              </div>
            </article>
          );
        })}

        {last && (
          <article class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end" data-slide-result hidden={upcoming.length > 0}>
            <div>
              <p>
                <span class="font-bold">{teamNames[last.selekcija]}</span> {last.tekmovanje}, zadnja tekma
              </p>
              <p class="mt-4 text-h1 font-extrabold [font-stretch:125%]">
                {sides(last)[0]}
                <span aria-hidden="true"> – </span>
                <span class="sr-only"> proti </span>
                {sides(last)[1]}
              </p>
              <p class="mt-3">
                <time datetime={last.zacetek}>{formatDateLong(last.zacetek)}</time>
              </p>
            </div>
            <div class="md:text-right">
              <p class="text-h1 font-extrabold text-ball tabular-nums">{scoreForLoka(last)}</p>
              <div class="mt-6">
                <Button href="/tekme/" variant="on-ink" arrow>
                  Vse tekme
                </Button>
              </div>
            </div>
          </article>
        )}
      </div>
    </section>
  )
}

<style>
  /* Photos lie on top of each other; only the active one is visible. */
  .board-photo {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .board-photo[data-active] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .board-photo {
      transition: none;
    }
  }

  /* Ball-hole pattern: the SVG only masks, the colour is the ball token at ~12 %. Static (SPEC.md §9.4, §9.6). */
  .board-pattern {
    position: absolute;
    inset: 0;
    background-color: var(--color-ball);
    opacity: 0.12;
    mask-image: url("../assets/ball-holes.svg");
    mask-size: 240px 240px;
    mask-repeat: repeat;
  }

  /* Over a photo the full pattern reads as spots on faces: half the strength keeps the club mark. */
  .board-pattern-soft {
    opacity: 0.06;
  }
</style>

<script>
  // Picks the board match in the browser and keeps the countdown fresh (SPEC.md §7.1).
  // The rows of "Naslednje tekme" ([data-upcoming-row]) follow the same 3-hour rule.
  import { currentTime } from "../lib/clock.ts";
  import { formatCountdown, pick } from "../lib/upcoming.ts";

  const board = document.querySelector<HTMLElement>("[data-board]");
  const upcomingSection = document.querySelector<HTMLElement>("[data-upcoming-section]");

  function update() {
    const now = currentTime();

    if (board) {
      const slides = [...board.querySelectorAll<HTMLElement>("[data-slide]")];
      const result = board.querySelector<HTMLElement>("[data-slide-result]");
      const state = pick(slides.map((slide) => slide.dataset.start ?? ""), now);

      slides.forEach((slide, i) => (slide.hidden = i !== state.board));
      if (result) result.hidden = state.board !== null;
      board.hidden = state.board === null && !result;

      const current = state.board === null ? null : slides[state.board];
      if (current) {
        (current.querySelector("[data-today]") as HTMLElement).hidden = !state.today;
        (current.querySelector("[data-live]") as HTMLElement).hidden = !state.today;
        (current.querySelector("[data-countdown]") as HTMLElement).textContent = state.live
          ? "Tekma poteka"
          : formatCountdown(state.msToStart);
      }
    }

    if (upcomingSection) {
      const rows = [...upcomingSection.querySelectorAll<HTMLElement>("[data-start]")];
      const { visible } = pick(rows.map((row) => row.dataset.start ?? ""), now);
      rows.forEach((row, i) => (row.hidden = !visible[i]));
      upcomingSection.hidden = !visible.includes(true);
    }
  }

  update();
  setInterval(update, 60_000);

  // Photos behind the board: next photo every 6 s. Never starts with "reduce motion" (WCAG 2.2.2).
  const photos = board ? [...board.querySelectorAll<HTMLElement>("[data-photo]")] : [];
  const photoToggle = board?.querySelector<HTMLButtonElement>("[data-photos-toggle]");
  const photoLabel = board?.querySelector<HTMLElement>("[data-photos-label]");

  if (photos.length > 1 && photoToggle && photoLabel && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let active = 0;
    let timer: number | undefined;
    const next = () => {
      const following = (active + 1) % photos.length;
      // A photo that has not loaded yet would fade in as an empty black board: wait for the next tick.
      const img = photos[following]?.querySelector("img");
      if (!img?.complete || img.naturalWidth === 0) return;
      photos[active]?.removeAttribute("data-active");
      active = following;
      photos[active]?.setAttribute("data-active", "");
    };
    const play = () => {
      timer = window.setInterval(next, 6000);
      photoLabel.textContent = "Ustavi";
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
      photoLabel.textContent = "Nadaljuj";
    };

    photoToggle.hidden = false;
    photoToggle.addEventListener("click", () => (timer === undefined ? play() : stop()));
    play();
  }
</script>
