---
// Base layout for every page (SPEC.md §13.2, §13.3):
// <html lang="sl">, skip link as the first element, header, <main id="main">, footer.
// OG image, JSON-LD and the rest of the SEO head follow in step 7.
import "../styles/global.css";
// The one font file above the fold is preloaded (SPEC.md §9.3). Same hashed file as in global.css.
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";

interface Props {
  /** Page name, e.g. "Treningi". */
  title: string;
  /** Unique meta description for the page. */
  description: string;
  /** Keep the page out of search results (/hvala, /404). */
  noindex?: boolean;
  /** Structured data for this page (schema.org objects). */
  jsonLd?: object | object[];
  /** Share image instead of the logo, e.g. a news cover. url is absolute. */
  ogImage?: { url: URL; width: number; height: number; alt: string };
}

const { title, description, noindex = false, jsonLd, ogImage } = Astro.props;
// Title pattern "Treningi | FBK Loka" (SPEC.md §13.2).
const fullTitle = `${title} | FBK Loka`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Default share image: the logo on black (SPEC.md §13.2). A page may pass its own (news covers).
const share = ogImage ?? { url: new URL("/og.png", Astro.site), width: 1200, height: 630, alt: "Logo FBK Loka" };
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FBK Loka" />
    <meta property="og:locale" content="sl_SI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={share.url} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <JsonLd data={jsonLd} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skoči na vsebino</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Skip link: hidden until it gets keyboard focus, then shown over the header. */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 60;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background-color: var(--color-ball);
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 0.5rem;
  }
</style>
